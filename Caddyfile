# Static files and one proxied path. Nothing here talks to a database: the pages
# were built last night, and only the sign-up form reaches the application.
:80 {
	encode gzip zstd

	handle /api/* {
		reverse_proxy daily-api:3090
	}

	handle {
		root * /srv

		# /28-09/ is the same page as /28-09. Without this, try_files falls through
		# to the 404 page for every link that picked up a trailing slash.
		@slash path_regexp trailing ^/(.+)/$
		redir @slash /{re.trailing.1} 301

		# Caddy applies same-name directives in order and a later `header` replaces
		# an earlier value, so the short-lived pages are matched explicitly rather
		# than set as a default that would overwrite everything above it.
		@volatile path / /index.html /archive /archive.html /feed.xml
		header @volatile Cache-Control "public, max-age=300"

		# Short dates change year, and full dates can be rebuilt after a correction.
		@day path_regexp ^/(\d{2}-\d{2}|\d{4}-\d{2}-\d{2})(\.html)?$
		header @day Cache-Control "public, max-age=300"

		@assets path /_app/immutable/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		try_files {path} {path}.html {path}/index.html
		file_server
	}

	# The 404 page, served with an actual 404. Behind try_files it answered 200,
	# so a missing image came back as a page and a crawler saw every dead URL as
	# a real one.
	handle_errors {
		rewrite * /404.html
		root * /srv
		file_server
	}
}
