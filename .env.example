# Copy to .env and fill in. Never commit .env.

# OpenAI — used for article summaries.
OPENAI_API_KEY=
# gpt-6-luna since 2026-10-09: newest and cheapest tier.
OPENAI_MODEL=gpt-6-luna

# Telegram — create the bot via @BotFather, add it to the channel as admin.
TELEGRAM_BOT_TOKEN=
# Channel id, e.g. -1001234567890, or @channelusername
TELEGRAM_CHANNEL_ID=

# Self-hosted RSSHub, for sources with no native feed.
RSSHUB_BASE_URL=http://localhost:1200

# 1 = print the digest to the console instead of posting it.
DRY_RUN=1

# Reddit: .json answers 403 and old.reddit serves no post markup, so threads
# need the official API. Create a "script" app at reddit.com/prefs/apps —
# the id is the short string under the app name, the secret is next to it.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── daily digest (apps/daily-api) ────────────────────────────────────────────
# Neon connection string. The only storage, shared by the bot and the page.
DATABASE_URL=
# Resend API key, and the address the digest is sent from. The domain
# tldr.cdroma.me is verified in Resend; its records live on send.tldr.cdroma.me
# and resend._domainkey.tldr.cdroma.me, so the site's own CNAME is untouched.
RESEND_API_KEY=
MAIL_FROM=TLDR <daily@tldr.cdroma.me>
# 1 prints the email instead of sending it. Keep it on until the first live test.
MAIL_DRY_RUN=1
SITE_URL=https://tldr.cdroma.me
API_PORT=3090

# ── shared ───────────────────────────────────────────────────────────────────
# The source list both apps read. Set in the images; here for local overrides.
# SOURCES_PATH=packages/sources/sources.yaml
# TZ_NAME=Europe/Belgrade
