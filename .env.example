# Copy to .env and fill in. Never commit .env.

# OpenAI — used for article summaries.
OPENAI_API_KEY=
# Chosen by bake-off on 2026-09-20: terra picks better details than luna.
OPENAI_MODEL=gpt-5.6-terra

# Telegram — create the bot via @BotFather, add it to the channel as admin.
TELEGRAM_BOT_TOKEN=
# Channel id, e.g. -1001234567890, or @channelusername
TELEGRAM_CHANNEL_ID=

# Self-hosted RSSHub, for sources with no native feed.
RSSHUB_BASE_URL=http://localhost:1200

# 1 = print the digest to the console instead of posting it.
DRY_RUN=1

# Reddit: .json answers 403 and old.reddit serves no post markup, so threads
# need the official API. Create a "script" app at reddit.com/prefs/apps —
# the id is the short string under the app name, the secret is next to it.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
